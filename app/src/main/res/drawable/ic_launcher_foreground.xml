<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: cloud + share-nodes mark (matches assets/logo.svg).
    Designed for the 108dp adaptive-icon canvas; the mark stays inside the
    66dp safe circle so no launcher crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cloud outline (3 lobes, round joins) -->
    <path
        android:pathData="M44,62 C37,62 32,57 32,50 C32,44 36,40 42,38 C43,30 50,24 58,24
                           C64,24 69,28 71,34 C72,34 73,34 74,34 C80,34 85,39 85,46
                           C85,53 80,62 72,62 L44,62"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Share connectors -->
    <path
        android:pathData="M47,46 L63,39"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.85"
        android:strokeWidth="3"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M47,46 L61,54"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.85"
        android:strokeWidth="3"
        android:strokeLineCap="round"/>

    <!-- Share nodes: teal origin, white targets -->
    <path
        android:fillColor="#4DD0E1"
        android:pathData="M47,46 m-5,0 a5,5 0 1,1 10,0 a5,5 0 1,1 -10,0"/>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M63,39 m-5,0 a5,5 0 1,1 10,0 a5,5 0 1,1 -10,0"/>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M61,53 m-5,0 a5,5 0 1,1 10,0 a5,5 0 1,1 -10,0"/>
</vector>
